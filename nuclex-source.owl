        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:loinc_id>https://loinc.org/LP208025-9</nx:loinc_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C74720</nx:ncit_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000578 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000578">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000577"/>
        <oboInOwl:id>NUCLEX:0000578</oboInOwl:id>
        <rdfs:label>tumor volume measurement</rdfs:label>
        <skos:altLabel>disease burden measurement</skos:altLabel>
        <skos:definition>A measurement that quantifies the volume of a tumor, as measured on an image.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000579 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000579">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000578"/>
        <oboInOwl:id>NUCLEX:0000579</oboInOwl:id>
        <rdfs:label>metabolic tumor volume</rdfs:label>
        <skos:altLabel>MTV</skos:altLabel>
        <skos:definition>The volume of a single tumor demonstrating increased metabolic activity, as measured on a FDG PET scan.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000580 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000580">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000578"/>
        <oboInOwl:id>NUCLEX:0000580</oboInOwl:id>
        <rdfs:label>tumor volume</rdfs:label>
        <skos:altLabel>lesion volume</skos:altLabel>
        <skos:definition>The volume of a single tumor as measured using anatomical imaging (CT, MRI).</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C94515</nx:ncit_id>
        <nx:snomedct_id>http://snomed.info/id/258261001</nx:snomedct_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000581 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000581">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000578"/>
        <oboInOwl:id>NUCLEX:0000581</oboInOwl:id>
        <rdfs:label>total tumor volume</rdfs:label>
        <skos:altLabel>TTB</skos:altLabel>
        <skos:altLabel>TTV</skos:altLabel>
        <skos:altLabel>total lesion volume</skos:altLabel>
        <skos:altLabel>total tumor burden</skos:altLabel>
        <skos:altLabel>whole-body tumor volume</skos:altLabel>
        <skos:definition>The summed volume of all identified tumors within a patient using anatomical imaging (CT, MRI), representing the total systemic anatomical tumor burden</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000582 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000582">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000578"/>
        <oboInOwl:id>NUCLEX:0000582</oboInOwl:id>
        <rdfs:label>total metabolic tumor volume</rdfs:label>
        <skos:altLabel>TMTV</skos:altLabel>
        <skos:altLabel>total metabolic tumor burden</skos:altLabel>
        <skos:definition>The summed metabolic volume of all metabolically active tumors within a patient as measured with FDG PET/CT, representing the total systemic metabolic tumor burden.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C202629</nx:ncit_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000583 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000583">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000578"/>
        <oboInOwl:id>NUCLEX:0000583</oboInOwl:id>
        <rdfs:label>total tumor uptake volume</rdfs:label>
        <skos:altLabel>TTUV</skos:altLabel>
        <skos:definition>The summed volume of all identified tumors within a patient as measured using molecular imaging (PET or SPECT).</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000584 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000584">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000577"/>
        <oboInOwl:id>NUCLEX:0000584</oboInOwl:id>
        <rdfs:label>total target uptake volume</rdfs:label>
        <skos:altLabel>TTaUV</skos:altLabel>
        <skos:definition>The summed volume of all regions expressing a molecular target within a patient as measured using molecular imaging (PET, SPECT).</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000585 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000585">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000577"/>
        <oboInOwl:id>NUCLEX:0000585</oboInOwl:id>
        <rdfs:label>organ volume</rdfs:label>
        <skos:definition>The total volume of an organ, as measured in an image.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000586 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000586">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000577"/>
        <oboInOwl:id>NUCLEX:0000586</oboInOwl:id>
        <rdfs:label>end-diastolic volume</rdfs:label>
        <skos:altLabel>EDV</skos:altLabel>
        <skos:definition>The maximum volume of blood contained within a cardiac ventricle at the end of the diastolic relaxation phase, as measured in an image.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000587 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000587">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000577"/>
        <oboInOwl:id>NUCLEX:0000587</oboInOwl:id>
        <rdfs:label>end-systolic volume</rdfs:label>
        <skos:altLabel>ESV</skos:altLabel>
        <skos:definition>The minimum volume of blood remaining within a cardiac ventricle at the end of the systolic contraction phase, as measured in an image.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000588 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000588">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000588</oboInOwl:id>
        <rdfs:label>volume activity composite measurement</rdfs:label>
        <skos:altLabel>volumetric uptake measurement</skos:altLabel>
        <skos:definition>A measurement combining the spatial volume with the activity concentration of a region.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000589 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000589">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000588"/>
        <oboInOwl:id>NUCLEX:0000589</oboInOwl:id>
        <rdfs:label>total lesion glygolysis</rdfs:label>
        <skos:altLabel>TLG</skos:altLabel>
        <skos:definition>The product of the metabolic tumor volume and the mean SUV of the identified tumor regions.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000590 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000590">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000588"/>
        <oboInOwl:id>NUCLEX:0000590</oboInOwl:id>
        <rdfs:label>total lesion uptake</rdfs:label>
        <skos:altLabel>TLU</skos:altLabel>
        <skos:definition>THe product of the total tumor volume with the mean SUV of the identified tumor regions.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C202627</nx:ncit_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000591 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000591">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000591</oboInOwl:id>
        <rdfs:label>area-based measurement</rdfs:label>
        <skos:definition>Any 2-dimensional spatial measurement of a region&apos;s area.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000592 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000592">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000591"/>
        <oboInOwl:id>NUCLEX:0000592</oboInOwl:id>
        <rdfs:label>region of interest surface area</rdfs:label>
        <skos:altLabel>ROI surface area</skos:altLabel>
        <skos:altLabel>surface area</skos:altLabel>
        <skos:definition>The measured two-dimensional extent of the boundary or outer surface of a three-dimensional volume of interest.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000593 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000593">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000593</oboInOwl:id>
        <rdfs:label>activity concentration measurement</rdfs:label>
        <skos:altLabel>activity concentration measurement</skos:altLabel>

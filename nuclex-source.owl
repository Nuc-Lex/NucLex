<?xml version="1.0"?>
<rdf:RDF xmlns="https://nuclex.com/nuclex.owl#"
     xml:base="https://nuclex.com/nuclex.owl"
     xmlns:nx="https://nuclex.com/id/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://nuclex.com/nuclex.owl">
        <owl:versionIRI rdf:resource="https://nuclex.com/releases/1.0.0/nuclex.owl"/>
        <dcterms:created>2026-11-13</dcterms:created>
        <dcterms:creator>Tyler Bradshaw</dcterms:creator>
        <dcterms:description>NucLex is an ontology of nuclear medicine, theranostics, and molecular imaging. It covers imaging and therapy procedures, radiopharmaceuticals and radionuclides,  instrumentation, acquisition and reconstruction,  measurements, dosimetry, and the physical processes underlying them. Top-level classes align with SNOMED CT hierarchies, and terms carry mappings to SNOMED CT, the NCI Thesaurus, RadLex, LOINC, UMLS, and DICOM.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified>2026-11-13</dcterms:modified>
        <dcterms:publisher>Institute of Nuclear Medicine</dcterms:publisher>
        <dcterms:title>NucLex: the Nuclear Medicine Ontology</dcterms:title>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    



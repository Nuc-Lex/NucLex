        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000626 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000626">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000624"/>
        <oboInOwl:id>NUCLEX:0000626</oboInOwl:id>
        <rdfs:label>intensity median</rdfs:label>
        <skos:altLabel>median intensity</skos:altLabel>
        <skos:altLabel>median voxel value</skos:altLabel>
        <skos:definition>The median voxel value within a region of interest.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000627 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000627">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000624"/>
        <oboInOwl:id>NUCLEX:0000627</oboInOwl:id>
        <rdfs:label>intensity standard deviation</rdfs:label>
        <skos:altLabel>intensity SD</skos:altLabel>

        <skos:altLabel>small ACR SPECT phantom</skos:altLabel>
        <skos:altLabel>small Jaszczak Deluxe phantom</skos:altLabel>
        <skos:definition>A scaled-down version of the ACR-approved SPECT phantom designed specifically for use with small field-of-view SPECT cameras.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000739 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000739">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
        <oboInOwl:id>NUCLEX:0000739</oboInOwl:id>
        <rdfs:label>National Electrical Manufacturers Association International Electrotechnical Commission body phantom</rdfs:label>
        <skos:altLabel>NEMA IEC body phantom</skos:altLabel>
        <skos:altLabel>NEMA image quality phantom</skos:altLabel>
        <skos:altLabel>NEMA phantom</skos:altLabel>
        <skos:definition>A standardized fillable body-shaped phantom specified by NEMA and the IEC, typically containing a simulated background compartment, a lung insert, and several fillable spheres, used to evaluate image quality.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000740 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000740">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000739"/>
        <oboInOwl:id>NUCLEX:0000740</oboInOwl:id>

        <skos:altLabel>ACR-approved SPECT phantom</skos:altLabel>
        <skos:altLabel>Data Spectrum Deluxe phantom</skos:altLabel>
        <skos:altLabel>Jaszczak Deluxe phantom</skos:altLabel>
        <skos:altLabel>Jaszczak SPECT phantom</skos:altLabel>
        <skos:altLabel>flangeless deluxe Jaszczak phantom</skos:altLabel>
        <skos:definition>A fillable phantom composed of a Jaszczak phantom body with a rod resolution pattern paired with cold spherical inserts of varying diameters to assess spatial resolution, object detectability, and uniformity.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000738 -->


        <skos:altLabel>ROI feature</skos:altLabel>
        <skos:altLabel>first-order feature</skos:altLabel>
        <skos:definition>A quantity calculated from the distribution of voxel values within a delineated volume.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000624 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000624">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000623"/>
        <oboInOwl:id>NUCLEX:0000624</oboInOwl:id>
        <rdfs:label>intensity-based statistical feature</rdfs:label>
        <skos:altLabel>statistical features</skos:altLabel>

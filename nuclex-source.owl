        <oboInOwl:id>NUCLEX:0000613</oboInOwl:id>
        <rdfs:label>tissue ratio measurement</rdfs:label>
        <skos:definition>Any measurement of radioactivity in a region of interest that is normalized by the radioactivity measurement in another region.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000614 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000614">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000613"/>
        <oboInOwl:id>NUCLEX:0000614</oboInOwl:id>
        <rdfs:label>tumor-to-background ratio measurement</rdfs:label>
        <skos:altLabel>TBR</skos:altLabel>
        <skos:definition>The ratio of the radioactivity in a target region of interest to the radioactivity in an adjacent, normal background tissue.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000615 -->


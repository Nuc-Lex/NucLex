        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000615"/>
        <oboInOwl:id>NUCLEX:0000616</oboInOwl:id>
        <rdfs:label>tumor-to-kidney ratio measurement</rdfs:label>
        <skos:altLabel>TKR</skos:altLabel>
        <skos:altLabel>tumour-to-kidney ratio</skos:altLabel>
        <skos:definition>The quotient of radiotracer uptake in a lesion and uptake measured in the kidney.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000617 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000617">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000615"/>
        <oboInOwl:id>NUCLEX:0000617</oboInOwl:id>
        <rdfs:label>tumor-to-liver ratio measurement</rdfs:label>
        <skos:altLabel>TLR</skos:altLabel>
        <skos:altLabel>tumour-to-liver ratio</skos:altLabel>
        <skos:definition>The quotient of radiotracer uptake in a lesion and uptake measured in the liver.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000618 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000618">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000613"/>
        <oboInOwl:id>NUCLEX:0000618</oboInOwl:id>
        <rdfs:label>tumor-to-blood pool ratio measurement</rdfs:label>
        <skos:altLabel>tumor-to-blood ratio</skos:altLabel>
        <skos:altLabel>tumour-to-blood pool ratio</skos:altLabel>
        <skos:definition>The quotient of radiotracer uptake in a lesion and uptake in a vascular reference region.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000619 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000619">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000618"/>
        <oboInOwl:id>NUCLEX:0000619</oboInOwl:id>
        <rdfs:label>tumor-to-descending aorta ratio measurement</rdfs:label>
        <skos:altLabel>tumour-to-descending aorta ratio</skos:altLabel>
        <skos:definition>The quotient of radiotracer uptake in a lesion and uptake measured in the descending aorta.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000620 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000620">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000618"/>
        <oboInOwl:id>NUCLEX:0000620</oboInOwl:id>
        <rdfs:label>tumor-to-left ventricle ratio measurement</rdfs:label>
        <skos:altLabel>tumour-to-left ventricle ratio</skos:altLabel>
        <skos:definition>The quotient of radiotracer uptake in a lesion and uptake measured in the left ventricular blood pool.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000621 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000621">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000613"/>
        <oboInOwl:id>NUCLEX:0000621</oboInOwl:id>
        <rdfs:label>standardized uptake value ratio measurement</rdfs:label>
        <skos:altLabel>SUVR</skos:altLabel>
        <skos:altLabel>mean SUVR</skos:altLabel>
        <skos:definition>The ratio of the radioactivity in a target region of interest to the radioactivity in a specified reference region (e.g., cerebellum).</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000622 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000622">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000613"/>
        <oboInOwl:id>NUCLEX:0000622</oboInOwl:id>
        <rdfs:label>lung shunt fraction</rdfs:label>
        <skos:altLabel>LSF</skos:altLabel>
        <skos:definition>The ratio of the number of radioactive particles that reach the lungs, as approximated by nuclear medicine image measurements, to the total number of particles that reach both the lungs and liver, after they are injected into the hepatic artery as part of radioembolization.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000623 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000623">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000623</oboInOwl:id>

        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:obo_id rdf:resource="http://purl.obolibrary.org/obo/OBI_0001086"/>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000769 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000769">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000768"/>
        <oboInOwl:id>NUCLEX:0000769</oboInOwl:id>
        <rdfs:comment>IUPAC suggest the term activity over radioactivity</rdfs:comment>
        <rdfs:label>activity assay device</rdfs:label>
        <skos:altLabel>activity measurement device</skos:altLabel>
        <skos:altLabel>radioactivity assay device</skos:altLabel>
        <skos:altLabel>radioactivity measurement device</skos:altLabel>
        <skos:definition>A device used to measure and quantify the activity in a radioactive sample.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000770 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000770">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000769"/>
        <oboInOwl:id>NUCLEX:0000770</oboInOwl:id>
        <rdfs:label>radionuclide calibrator</rdfs:label>
        <skos:altLabel>activity meter</skos:altLabel>
        <skos:altLabel>dose calibrator</skos:altLabel>
        <skos:altLabel>radioactivity meter</skos:altLabel>
        <skos:definition>A gas-filled instrument that measures the activity of a radioactive sample.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C94887</nx:ncit_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000771 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000771">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000769"/>
        <oboInOwl:id>NUCLEX:0000771</oboInOwl:id>
        <rdfs:label>well-type scintillation counter</rdfs:label>
        <skos:altLabel>well counter</skos:altLabel>
        <skos:altLabel>wipe test counter</skos:altLabel>
        <skos:definition>An instrument containing a scintillator detector with a cavity into which a sample is placed for activity measurement.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000772 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000772">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000771"/>
        <oboInOwl:id>NUCLEX:0000772</oboInOwl:id>
        <rdfs:label>auto gamma counter</rdfs:label>
        <skos:altLabel>automatic gamma counter</skos:altLabel>
        <skos:altLabel>gamma counter</skos:altLabel>
        <skos:definition>A radioactivity counting instrument that processes multiple samples in sequence without operator intervention.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000773 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000773">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000771"/>
        <oboInOwl:id>NUCLEX:0000773</oboInOwl:id>
        <rdfs:label>multi-well counter</rdfs:label>
        <skos:altLabel>multi-well gamma counter</skos:altLabel>
        <skos:definition>A sample counting instrument containing more than one detector cavity.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000774 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000774">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000769"/>
        <oboInOwl:id>NUCLEX:0000774</oboInOwl:id>
        <rdfs:label>liquid scintillation counter</rdfs:label>
        <skos:altLabel>LSC</skos:altLabel>
        <skos:altLabel>liquid scintillator</skos:altLabel>
        <skos:definition>An instrument that measures sample activity by detecting light emitted from a scintillating solution in which the sample is dissolved.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:snomedct_id>http://snomed.info/id/462902009</nx:snomedct_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000775 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000775">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000769"/>
        <oboInOwl:id>NUCLEX:0000775</oboInOwl:id>
        <rdfs:label>thyroid probe</rdfs:label>
        <skos:altLabel>thyroid uptake probe</skos:altLabel>
        <skos:altLabel>uptake probe</skos:altLabel>
        <skos:definition>A collimated detector designed to measure radioactivity within the thyroid gland.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000776 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000776">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000768"/>
        <oboInOwl:id>NUCLEX:0000776</oboInOwl:id>
        <rdfs:label>radiation survey instrument</rdfs:label>
        <skos:altLabel>survey meter</skos:altLabel>
        <skos:definition>A portable radiation measurement device engineered for the real-time detection and quantification of ambient radiation fields or surface radioactive contamination.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000777 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000777">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000776"/>
        <oboInOwl:id>NUCLEX:0000777</oboInOwl:id>
        <rdfs:label>gas-filled detector instrument</rdfs:label>
        <skos:altLabel>gas ionization detector</skos:altLabel>
        <skos:altLabel>gas proportional detector</skos:altLabel>
        <skos:altLabel>gas-filled detector</skos:altLabel>
        <skos:definition>A radiation measurement device that detects ionizing radiation via the collection of electron-ion pairs generated within an enclosed gaseous volume subjected to an applied electric field.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000778 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000778">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000777"/>
        <oboInOwl:id>NUCLEX:0000778</oboInOwl:id>
        <rdfs:label>ionization chamber survey meter</rdfs:label>
        <skos:altLabel>ionization chamber surveymeter</skos:altLabel>
        <skos:definition>A gas-filled detector instrument operating in a voltage region where collected charge is strictly proportional to the energy deposited by the incident radiation, enabling accurate quantification of true exposure or dose rates.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000779 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000779">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000777"/>
        <oboInOwl:id>NUCLEX:0000779</oboInOwl:id>
        <rdfs:label>survey meter</rdfs:label>
        <skos:altLabel>surveymeter</skos:altLabel>
        <skos:definition>A portable radiation measurement device utilized to dynamically scan environments and surfaces to detect and quantify ambient radiation levels or localized contamination.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000780 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000780">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000777"/>
        <oboInOwl:id>NUCLEX:0000780</oboInOwl:id>
        <rdfs:label>Geiger-Muller counter</rdfs:label>
        <skos:altLabel>A gas-filled detector instrument operating at a high voltage that produces a full  avalanche for each ionizing event, providing highly sensitive detection of radiation without incident energy discrimination.</skos:altLabel>
        <skos:altLabel>GM counter</skos:altLabel>
        <skos:altLabel>Geiger counter</skos:altLabel>
        <skos:definition>A gas-filled detector instrument operated at a voltage at which each ionizing event produces a gas discharge of uniform size.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000781 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000781">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000780"/>
        <oboInOwl:id>NUCLEX:0000781</oboInOwl:id>
        <rdfs:label>pancake probe Geiger-Muller counter</rdfs:label>
        <skos:altLabel>pancake surveymeter</skos:altLabel>
        <skos:definition>A Geiger-Müller counter equipped with a flattened, large-surface-area entrance window engineered to maximize detection geometry and efficiency for particulate radiation.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000782 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000782">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000780"/>
        <oboInOwl:id>NUCLEX:0000782</oboInOwl:id>
        <rdfs:label>energy-compensated Geiger-Muller probe</rdfs:label>
        <skos:definition>A Geiger-Müller detector enclosed within a specific metallic filter designed to attenuate low-energy photons, correcting the inherent detector over-response to yield a uniform dose rate measurement across varying photon energies.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000783 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000783">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000780"/>
        <oboInOwl:id>NUCLEX:0000783</oboInOwl:id>
        <rdfs:label>telescopic tube Geiger-Muller counter</rdfs:label>
        <skos:altLabel>Telepole</skos:altLabel>
        <skos:altLabel>telescopic survey meter</skos:altLabel>
        <skos:definition>A Geiger-Müller counter featuring a detector mounted on an extendable physical rod to facilitate the measurement of high-intensity radiation fields from a distanced or shielded position.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000784 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000784">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000777"/>
        <oboInOwl:id>NUCLEX:0000784</oboInOwl:id>
        <rdfs:label>proportional counter</rdfs:label>
        <skos:definition>A gas-filled detector instrument operating at an intermediate voltage where primary ionization events trigger localized Townsend avalanches, generating an output signal proportional to the initial energy deposition.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000785 -->


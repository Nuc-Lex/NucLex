    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://nuclex.com/id/NUCLEX_0000001 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000001">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000297"/>
        <oboInOwl:id>NUCLEX:0000001</oboInOwl:id>
        <rdfs:label>photon interaction</rdfs:label>
        <skos:altLabel>gamma ray interaction</skos:altLabel>
        <skos:altLabel>radiation interaction</skos:altLabel>
        <skos:altLabel>x-ray interaction</skos:altLabel>
        <skos:definition>A radiation interaction in which the incident radiation is a photon.</skos:definition>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000002 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000002">
        <oboInOwl:id>NUCLEX:0000002</oboInOwl:id>
        <rdfs:comment>Top-level class of SNOMED-CT</rdfs:comment>
        <rdfs:label>procedure</rdfs:label>
        <skos:altLabel>clinical procedure</skos:altLabel>
        <skos:altLabel>medical procedure</skos:altLabel>
        <skos:definition>Activities performed in the provision of health care.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C79751</nx:ncit_id>
        <nx:radlex_id>http://www.radlex.org/RID/RID1559</nx:radlex_id>
        <nx:snomedct_id>http://snomed.info/id/71388002</nx:snomedct_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000003 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000003">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000297"/>
        <oboInOwl:id>NUCLEX:0000003</oboInOwl:id>
        <rdfs:label>neutron interaction</rdfs:label>
        <skos:definition>A radiation interaction in which the incident radiation is a neutron.</skos:definition>
        <nx:approver_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1001</nx:approver_id>
        <nx:status>draft</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000004 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000004">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000003"/>
        <oboInOwl:id>NUCLEX:0000004</oboInOwl:id>
        <rdfs:label>neutron capture</rdfs:label>
        <skos:altLabel>(n,γ) reaction</skos:altLabel>
        <skos:definition>Absorption of a neutron by a nucleus, forming a heavier isotope usually in an excited state.</skos:definition>
        <nx:approver_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1001</nx:approver_id>
        <nx:status>draft</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000005 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000005">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000002"/>
        <oboInOwl:id>NUCLEX:0000005</oboInOwl:id>
        <rdfs:label>treatment</rdfs:label>
        <skos:altLabel>healthcare intervention</skos:altLabel>
        <skos:altLabel>intervention</skos:altLabel>
        <skos:altLabel>therapeutic intervention</skos:altLabel>
        <skos:altLabel>therapeutic procedure</skos:altLabel>
        <skos:altLabel>therapy</skos:altLabel>
        <skos:definition>The use of pharmaceutical agents, radiation, surgery, or other medical interventions intended to cure, ameliorate, or manage a disease, injury, or medical condition.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:obo_id>http://purl.obolibrary.org/obo/OGMS_0000090</nx:obo_id>
        <nx:radlex_id>http://www.radlex.org/RID/RID8</nx:radlex_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000006 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000006">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0001972"/>
        <oboInOwl:id>NUCLEX:0000006</oboInOwl:id>
        <rdfs:label>image finding</rdfs:label>
        <skos:altLabel>imaging finding</skos:altLabel>
        <skos:definition>A clinical observation identified on a medical image.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:obo_id rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000017"/>
        <nx:snomedct_id rdf:resource="http://snomed.info/id/365853002"/>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000007 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000007">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000005"/>
        <oboInOwl:id>NUCLEX:0000007</oboInOwl:id>
        <rdfs:label>therapy</rdfs:label>
        <skos:altLabel>therapeutic treatment</skos:altLabel>
        <skos:definition>A procedure carried out with the intention of curing, controlling, or relieving disease.</skos:definition>
        <nx:assigned_to>1001;1002;1003</nx:assigned_to>
        <nx:snomedct_id>http://snomed.info/id/276239002</nx:snomedct_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000008 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000008">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000003"/>
        <oboInOwl:id>NUCLEX:0000008</oboInOwl:id>
        <rdfs:label>elastic neutron scattering</rdfs:label>
        <skos:definition>The deflection of a neutron by a nucleus with conservation of total kinetic energy.</skos:definition>
        <nx:assigned_to rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1001</nx:assigned_to>
        <nx:status>draft</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000009 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000009">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000835"/>
        <oboInOwl:id>NUCLEX:0000009</oboInOwl:id>
        <rdfs:label>processed material</rdfs:label>
        <skos:definition>A substance that has been manufactured or refined for a particular purpose.</skos:definition>
        <nx:approver_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1001</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000010 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000010">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000007"/>
        <oboInOwl:id>NUCLEX:0000010</oboInOwl:id>
        <rdfs:comment>In SNOMED, listed as &quot;radionuclide therapy&quot;.</rdfs:comment>
        <rdfs:label>radiopharmaceutical therapy</rdfs:label>
        <skos:altLabel>endoradiotherapy</skos:altLabel>
        <skos:altLabel>internal radiotherapy</skos:altLabel>
        <skos:altLabel>molecular radiotherapy</skos:altLabel>
        <skos:altLabel>nuclear medicine therapy</skos:altLabel>
        <skos:altLabel>radioisotope therapy</skos:altLabel>
        <skos:altLabel>radionuclide therapy</skos:altLabel>
        <skos:altLabel>targeted radionuclide therapy</skos:altLabel>
        <skos:altLabel>unsealed radionuclide therapy</skos:altLabel>
        <skos:definition>A targeted medical treatment that administers unsealed radiolabeled agents to patients for internal radiation treatment.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C192439</nx:ncit_id>
        <nx:snomedct_id>http://snomed.info/id/399315003</nx:snomedct_id>
        <nx:snomedct_id>http://snomed.info/id/448288001</nx:snomedct_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000011 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000011">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0001978"/>

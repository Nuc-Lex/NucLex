        <skos:altLabel>%ID/g measurement</skos:altLabel>
        <skos:altLabel>percent injected dose per gram measurement</skos:altLabel>
        <skos:definition>The percentage of the total administered dose contained within one gram of a specified tissue.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000613 -->


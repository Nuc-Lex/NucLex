        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000595 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000595">

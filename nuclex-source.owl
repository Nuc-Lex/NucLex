    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000628 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000628">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000628</oboInOwl:id>
        <rdfs:label>intensity histogram feature</rdfs:label>
        <skos:definition>Any statistical metric derived directly from the intensity histogram of an image region, quantifying the distribution of voxel values without considering spatial relationships.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>ZVCW</nx:ibsi_id>
        <nx:status>approved</nx:status>

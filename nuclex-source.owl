    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#id -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#id"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- https://nuclex.com/id/approver_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/approver_id">
        <oboInOwl:id>nx:approver_id</oboInOwl:id>
        <rdfs:label>approver id</rdfs:label>
        <skos:definition>An identifier for the person who signed off on a concept in NucLex.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/assigned_to -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/assigned_to">
        <oboInOwl:id>nx:assigned_to</oboInOwl:id>
        <rdfs:label>assigned to</rdfs:label>
        <skos:definition>An identifier for the person responsible for curating a concept.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/dicom_tag -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/dicom_tag">
        <oboInOwl:id>nx:dicom_tag</oboInOwl:id>
        <rdfs:label>dicom tag</rdfs:label>
        <skos:definition>The group and element numbers identifying a corresponding attribute in the DICOM standard. In the format of (####,####).</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/ibsi_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/ibsi_id">
        <oboInOwl:id>nx:ibsi_id</oboInOwl:id>
        <rdfs:label>ibsi id</rdfs:label>
        <skos:definition>A code identifying a corresponding image biomarker in th eInternational Symposium on Biomedical Imaging (IBSI) reference manual.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/loinc_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/loinc_id">
        <oboInOwl:id>nx:loinc_id</oboInOwl:id>
        <rdfs:label>loinc id</rdfs:label>
        <skos:definition>A code identifying a corresponding term in LOINC.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/ncit_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/ncit_id">
        <oboInOwl:id>nx:ncit_id</oboInOwl:id>
        <rdfs:label>ncit id</rdfs:label>
        <skos:definition>A code identifying a corresponding term in the NCI Thesaurus.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/nucleon_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/nucleon_id">
        <oboInOwl:id>nx:nucleon_id</oboInOwl:id>
        <rdfs:label>nucleon id</rdfs:label>
        <skos:definition>A code identifying a corresponding nuclide in NUCLEON, the Nuclide and Element Ontology.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/obo_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/obo_id">
        <oboInOwl:id>nx:obo_id</oboInOwl:id>
        <rdfs:label>obo id</rdfs:label>
        <skos:definition>A code identifying a corresponding term in an Open Biomedical Ontologies vocabulary.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/playbook_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/playbook_id">
        <oboInOwl:id>nx:playbook_id</oboInOwl:id>
        <rdfs:label>playbook id</rdfs:label>
        <skos:definition>A code identifying a corresponding procedure in the RSNA Playbook.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/radlex_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/radlex_id">
        <oboInOwl:id>nx:radlex_id</oboInOwl:id>
        <rdfs:label>radlex id</rdfs:label>
        <skos:definition>A code identifying a corresponding term in RadLex.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/snomedct_id -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/snomedct_id">
        <oboInOwl:id>nx:snomedct_id</oboInOwl:id>
        <rdfs:label>snomedct id</rdfs:label>
        <skos:definition>A code identifying a corresponding concept in SNOMED CT.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/status -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/status">
        <oboInOwl:id>nx:status</oboInOwl:id>
        <rdfs:label>status</rdfs:label>
        <skos:definition>The stage a concept has reached in the review workflow: &quot;draft&quot; for a placeholder or exploratory entry, &quot;needs approval&quot; for a concept that is complete but awaiting review by other ontologists, and &quot;approved&quot; for one that has passed review.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://nuclex.com/id/umls_cui -->

    <owl:AnnotationProperty rdf:about="https://nuclex.com/id/umls_cui">
        <oboInOwl:id>nx:umls_cui</oboInOwl:id>
        <rdfs:label>umls cui</rdfs:label>
        <skos:definition>A concept unique identifier for a corresponding entry in the UMLS Metathesaurus.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://nuclex.com/id/has_input -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/has_input">
        <oboInOwl:id>nx:has_input</oboInOwl:id>
        <rdfs:label>has input</rdfs:label>
        <skos:definition>A relation holding between an activity and something it consumes or operates on.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/has_method -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/has_method">
        <oboInOwl:id>nx:has_method</oboInOwl:id>
        <rdfs:label>has method</rdfs:label>
        <skos:definition>A relation holding between an activity and the kind of action it carries out.</skos:definition>
        <nx:snomedct_id>http://snomed.info/id/260686004</nx:snomedct_id>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/has_molecular_target -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/has_molecular_target">
        <oboInOwl:id>nx:has_molecular_target</oboInOwl:id>
        <rdfs:label>has molecular target</rdfs:label>
        <skos:definition>A relation holding between a compound and the biological entity it binds.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/has_output -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/has_output">
        <oboInOwl:id>nx:has_output</oboInOwl:id>
        <rdfs:label>has output</rdfs:label>
        <skos:definition>A relation holding between an activity and something it produces.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/has_part -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/has_part">
        <owl:inverseOf rdf:resource="https://nuclex.com/id/part_of"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <oboInOwl:id>nx:has_part</oboInOwl:id>
        <rdfs:label>has part</rdfs:label>
        <skos:definition>A relation holding between a whole and something contained within it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/has_radionuclide -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/has_radionuclide">
        <oboInOwl:id>nx:has_radionuclide</oboInOwl:id>
        <rdfs:label>has radionuclide</rdfs:label>
        <skos:definition>A relation holding between a compound and the unstable atomic species it incorporates.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/has_theranostic_counterpart -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/has_theranostic_counterpart">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <oboInOwl:id>nx:has_theranostic_counterpart</oboInOwl:id>
        <rdfs:label>has theranostic counterpart</rdfs:label>
        <skos:definition>A relation holding between two agents that share a targeting mechanism but differ in whether they are intended for imaging or treatment.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/is_about -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/is_about">
        <oboInOwl:id>nx:is_about</oboInOwl:id>
        <rdfs:label>is about</rdfs:label>
        <skos:definition>A relation holding between a record or representation and what it describes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/made_of -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/made_of">
        <oboInOwl:id>nx:made_of</oboInOwl:id>
        <rdfs:label>made of</rdfs:label>
        <skos:definition>A relation holding between an object and what it consists of.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/part_of -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/part_of">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <oboInOwl:id>nx:part_of</oboInOwl:id>
        <rdfs:label>part of</rdfs:label>
        <skos:definition>A relation holding between something and the whole that contains it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/radiolabeled_analog_of -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/radiolabeled_analog_of">
        <oboInOwl:id>nx:radiolabeled_analog_of</oboInOwl:id>
        <rdfs:label>radiolabeled analog of</rdfs:label>
        <skos:definition>A relation holding between a compound and the unlabelled molecule whose structure it mimics.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/treats -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/treats">
        <oboInOwl:id>nx:treats</oboInOwl:id>
        <rdfs:label>treats</rdfs:label>
        <skos:definition>A relation holding between an intervention and the disorder it is intended to address.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/uses -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/uses">
        <oboInOwl:id>nx:uses</oboInOwl:id>
        <rdfs:label>uses</rdfs:label>
        <skos:definition>A relation holding between a process and something employed in carrying it out.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/using_device -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/using_device">
        <oboInOwl:id>nx:using_device</oboInOwl:id>
        <rdfs:label>using device</rdfs:label>
        <skos:definition>A relation holding between a process and a piece of equipment employed in carrying it out.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://nuclex.com/id/using_substance -->

    <owl:ObjectProperty rdf:about="https://nuclex.com/id/using_substance">
        <oboInOwl:id>nx:using_substance</oboInOwl:id>
        <rdfs:label>using substance</rdfs:label>
        <skos:definition>A relation holding between a process and a material employed in carrying it out.</skos:definition>
        <nx:snomedct_id>http://snomed.info/id/424361007</nx:snomedct_id>
    </owl:ObjectProperty>
    



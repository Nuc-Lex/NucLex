        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000251"/>
        <oboInOwl:id>NUCLEX:0000258</oboInOwl:id>
        <rdfs:label>Schilling test</rdfs:label>
        <skos:altLabel>vitamin B12 absorption test</skos:altLabel>
        <skos:altLabel>vitamin B12 test</skos:altLabel>
        <skos:definition>A non-imaging nuclear medicine procedure used to evaluate vitamin B12 malabsorption by orally administering radiolabeled vitamin B12 alongside an intramuscular injection of unlabeled B12, and subsequently measuring the radioactivity excreted in a 24-hour urine collection.</skos:definition>

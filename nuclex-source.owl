        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000613"/>
        <oboInOwl:id>NUCLEX:0000615</oboInOwl:id>
        <rdfs:label>tumor-to-organ ratio measurement</rdfs:label>
        <skos:altLabel>TOR</skos:altLabel>
        <skos:definition>The ratio of the radioactivity in a target region of interest to the radioactivity in a specified normal organ.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000616 -->


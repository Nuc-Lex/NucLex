        <oboInOwl:id>NUCLEX:0000599</oboInOwl:id>
        <rdfs:label>maximum activity</rdfs:label>
        <skos:altLabel>max Bq</skos:altLabel>
        <skos:altLabel>maximum Bq</skos:altLabel>

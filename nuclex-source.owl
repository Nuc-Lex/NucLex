        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000611 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000611">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000610"/>
        <oboInOwl:id>NUCLEX:0000611</oboInOwl:id>
        <rdfs:label>thyroid uptake measurement</rdfs:label>

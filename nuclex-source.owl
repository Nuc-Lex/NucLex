        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000776"/>
        <oboInOwl:id>NUCLEX:0000785</oboInOwl:id>
        <rdfs:label>scintillation detector instrument</rdfs:label>
        <skos:altLabel>scintillation detector</skos:altLabel>
        <skos:definition>A radiation measurement device utilizing a luminescent material coupled to a light sensor to convert incident ionizing radiation into quantifiable electrical pulses.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    



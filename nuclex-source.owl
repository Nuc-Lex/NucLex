    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000596 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000596">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000596</oboInOwl:id>
        <rdfs:label>activity measurement</rdfs:label>
        <skos:altLabel>absolute activity measurement</skos:altLabel>

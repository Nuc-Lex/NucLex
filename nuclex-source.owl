    <!-- https://nuclex.com/id/NUCLEX_0000331 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000331">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000268"/>
        <oboInOwl:id>NUCLEX:0000331</oboInOwl:id>
        <rdfs:label>nuclear medicine imaging-based dosimetry</rdfs:label>
        <skos:altLabel>image-based dosimetry</skos:altLabel>
        <skos:definition>A radiopharmaceutical dosimetry measurement method that utilizes data extracted from serial in vivo emission images.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000332 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000332">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000331"/>
        <oboInOwl:id>NUCLEX:0000332</oboInOwl:id>
        <rdfs:label>positron emission tomography-based dosimetry</rdfs:label>
        <skos:altLabel>PET-based dosimetry</skos:altLabel>
        <skos:definition>A dosimetry measurement method that utilizes data extracted from serial PET images.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000333 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000333">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000331"/>
        <oboInOwl:id>NUCLEX:0000333</oboInOwl:id>
        <rdfs:label>single-photon emission computed tomography-based dosimetry</rdfs:label>
        <skos:altLabel>SPECT-based dosimetry</skos:altLabel>
        <skos:definition>A dosimetry measurement method that utilizes data extracted from serial SPECT images.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000334 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000334">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000331"/>
        <oboInOwl:id>NUCLEX:0000334</oboInOwl:id>
        <rdfs:label>planar scintigraphy-based dosimetry</rdfs:label>
        <skos:altLabel>planar imaging-based dosimetry</skos:altLabel>
        <skos:definition>A dosimetry measurement method that utilizes data extracted from serial planar scintigraphy images.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000335 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000335">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000331"/>
        <oboInOwl:id>NUCLEX:0000335</oboInOwl:id>
        <rdfs:label>hybrid single-photon emission computed tomography/planar scintigraphy dosimetry</rdfs:label>
        <skos:altLabel>hybrid SPECT/planar dosimetry</skos:altLabel>
        <skos:definition>A dosimetry measurement method that utilizes hybrid data extracted from some combination of PET, SPECT, or planar scintigraphy images.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000336 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000336">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000268"/>
        <oboInOwl:id>NUCLEX:0000336</oboInOwl:id>
        <rdfs:label>biospecimen-based dosimetry</rdfs:label>
        <skos:altLabel>sample dosimetry</skos:altLabel>
        <skos:altLabel>specimen dosimetry</skos:altLabel>
        <skos:definition>A dosimetry measurement method that utilizes measurements of samples extracted from the subject.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000337 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000337">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000336"/>
        <oboInOwl:id>NUCLEX:0000337</oboInOwl:id>
        <rdfs:label>blood-based dosimetry</rdfs:label>
        <skos:altLabel>blood dosimetry</skos:altLabel>
        <skos:altLabel>blood surrogate dosimetry</skos:altLabel>
        <skos:definition>A dosimetry measurement method that utilizes measurements of blood samples extracted from the subject.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000338 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000338">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000275"/>
        <oboInOwl:id>NUCLEX:0000338</oboInOwl:id>
        <rdfs:label>radiopharmaceutical dosimetry calculation</rdfs:label>
        <skos:altLabel>dosimetry calculation method</skos:altLabel>
        <skos:definition>A method used to calculate quantities needed in the overall dosimetry process.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000339 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000339">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000338"/>
        <oboInOwl:id>NUCLEX:0000339</oboInOwl:id>
        <rdfs:label>absorbed dose calculation</rdfs:label>
        <skos:altLabel>AD method</skos:altLabel>
        <skos:definition>A method used to compute the energy deposited by ionizing radiation per unit mass of a target tissue or volume as part of dosimetry.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000340 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000340">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000339"/>
        <oboInOwl:id>NUCLEX:0000340</oboInOwl:id>
        <rdfs:label>voxel-based absorbed dose calculation</rdfs:label>
        <skos:altLabel>voxel-based dosimetry</skos:altLabel>
        <skos:definition>A method that computes the spatial distribution of absorbed doses across a three-dimensional grid of discrete volumetric elements representing the target geometry.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000341 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000341">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000340"/>
        <oboInOwl:id>NUCLEX:0000341</oboInOwl:id>
        <rdfs:label>kernel-based absorbed dose calculation</rdfs:label>
        <skos:altLabel>VSV dosimetry</skos:altLabel>
        <skos:altLabel>kernel dosimetry</skos:altLabel>
        <skos:definition>A voxel-based absorbed dose calculation that utilizes pre-calculated spatial energy deposition patterns to determine the dose contribution from a source to surrounding voxels.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000342 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000342">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000341"/>
        <oboInOwl:id>NUCLEX:0000342</oboInOwl:id>
        <rdfs:label>dose-point-kernel convolutional absorbed dose calculation</rdfs:label>
        <skos:altLabel>DPK dosimetry</skos:altLabel>
        <skos:definition>A kernel-based absorbed dose calculation that mathematically convolves a three-dimensional activity distribution with a radially symmetric function representing the energy deposition from a point source in a homogenous medium.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000343 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000343">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000340"/>
        <oboInOwl:id>NUCLEX:0000343</oboInOwl:id>
        <rdfs:label>Monte Carlo absorbed dose calculation</rdfs:label>
        <skos:altLabel>MC dosimetry</skos:altLabel>
        <skos:altLabel>MC dosimetry simulation</skos:altLabel>
        <skos:definition>An absorbed dose calculation method that computes energy deposition by stochastically simulating the transport and fundamental physical interactions of individual radiation particles through a defined anatomical model or voxel grid.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000344 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000344">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000339"/>
        <oboInOwl:id>NUCLEX:0000344</oboInOwl:id>
        <rdfs:label>organ-based absorbed dose calculation</rdfs:label>
        <skos:altLabel>organ-level dosimetry</skos:altLabel>
        <skos:definition>An absorbed dose calculation method that computes the average or mean energy deposited across the entirety of a defined anatomical organ or macroscopic region of interest, rather than resolving dose at a granular sub-organ level.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000345 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000345">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000344"/>
        <oboInOwl:id>NUCLEX:0000345</oboInOwl:id>
        <rdfs:label>model-based absorbed dose calculation</rdfs:label>
        <skos:altLabel>model-based dosimetry method</skos:altLabel>
        <skos:definition>An organ-based absorbed dose calculation that utilizes standardized mathematical representations of human anatomy and pre-calculated source-to-target specific absorbed fractions.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000346 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000346">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000345"/>
        <oboInOwl:id>NUCLEX:0000346</oboInOwl:id>
        <rdfs:label>medical internal dosimetry method</rdfs:label>
        <skos:altLabel>MIRD</skos:altLabel>
        <skos:altLabel>MIRD formulism</skos:altLabel>
        <skos:altLabel>MIRD method</skos:altLabel>
        <skos:altLabel>S-value based dosimetry</skos:altLabel>
        <skos:definition>A model-based absorbed dose calculation formalized by the Medical Internal Radiation Dose committee, utilizing the schema of source organs, target organs, and S-values to calculate mean absorbed doses from internally administered radionuclides.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000347 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000347">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000339"/>
        <oboInOwl:id>NUCLEX:0000347</oboInOwl:id>
        <rdfs:comment>Fits under both voxel-based and organ-based</rdfs:comment>
        <rdfs:label>local energy deposition absorbed dose calculation</rdfs:label>
        <skos:altLabel>LDM</skos:altLabel>
        <skos:altLabel>LED</skos:altLabel>
        <skos:altLabel>local deposition method</skos:altLabel>
        <skos:altLabel>local energy deposition method</skos:altLabel>
        <skos:definition>An absorbed dose calculation method that assumes all energy emitted by a radionuclide is completely absorbed within the immediate source volume</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000348 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000348">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000338"/>
        <oboInOwl:id>NUCLEX:0000348</oboInOwl:id>
        <rdfs:label>time-integrated activity calculation</rdfs:label>
        <skos:altLabel>TAC integration</skos:altLabel>
        <skos:altLabel>TIAC calculation</skos:altLabel>
        <skos:definition>A dosimetry process calculation method designed to determine the total number of radioactive disintegrations occurring within a specified source region over a defined integration period.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000349 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000349">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000348"/>
        <oboInOwl:id>NUCLEX:0000349</oboInOwl:id>
        <rdfs:label>numerical time-integrated activity calculation</rdfs:label>
        <skos:altLabel>numerical TIAC calculation</skos:altLabel>
        <skos:definition>A time-integrated activity calculation method that estimates total disintegrations by applying discrete mathematical integration techniques directly to a series of sequential activity measurements.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000350 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000350">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000349"/>
        <oboInOwl:id>NUCLEX:0000350</oboInOwl:id>
        <rdfs:label>trapezoidal time-integrated activity calculation</rdfs:label>
        <skos:altLabel>trapezoidal approach</skos:altLabel>
        <skos:altLabel>trapezoidal fitting method</skos:altLabel>
        <skos:altLabel>trapezoidal method</skos:altLabel>
        <skos:definition>A method that estimates the time-integrated activity by calculating the sum of the areas of geometric trapezoids mathematically formed between sequential, discrete measurement points.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000351 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000351">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000348"/>
        <oboInOwl:id>NUCLEX:0000351</oboInOwl:id>
        <rdfs:label>analytical time-integrated activity calculation</rdfs:label>
        <skos:altLabel>analytical TIAC calculation</skos:altLabel>
        <skos:definition>A time-integrated activity calculation method that estimates total disintegrations by fitting a continuous mathematical function to the measured activity data and integrating the resulting equation over time.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000352 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000352">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000338"/>
        <oboInOwl:id>NUCLEX:0000352</oboInOwl:id>
        <rdfs:comment>This branch may fit better under image analysis section.</rdfs:comment>
        <rdfs:label>time-activity curve fitting</rdfs:label>
        <skos:altLabel>TAC fitting method</skos:altLabel>
        <skos:definition>A method utilized to approximate the continuous kinetic behavior of a radiopharmaceutical within a target region by applying a mathematical function or numerical approximation to a discrete set of sequential activity measurements.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000353 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000353">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000352"/>
        <oboInOwl:id>NUCLEX:0000353</oboInOwl:id>
        <rdfs:label>exponential fitting</rdfs:label>
        <skos:altLabel>exponential TAC fitting</skos:altLabel>
        <skos:definition>A time-activity curve fitting method that models the clearance of radioactivity from a source region utilizing one or more exponential decay equations to represent first-order kinetic processes.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000354 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000354">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000353"/>
        <oboInOwl:id>NUCLEX:0000354</oboInOwl:id>
        <rdfs:label>monoexponential fitting</rdfs:label>
        <skos:altLabel>mono-exponential TAC fitting</skos:altLabel>
        <skos:altLabel>monoexponential TAC fitting</skos:altLabel>
        <skos:definition>An exponential fitting method that models time-activity data utilizing a single exponential term, representing clearance from the source region at a single, constant fractional rate.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000355 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000355">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000353"/>
        <oboInOwl:id>NUCLEX:0000355</oboInOwl:id>
        <rdfs:label>biexponential fitting</rdfs:label>

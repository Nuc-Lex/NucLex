        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:snomedct_id>http://snomed.info/id/706322000</nx:snomedct_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000734 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000734">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000733"/>
        <oboInOwl:id>NUCLEX:0000734</oboInOwl:id>
        <rdfs:label>fillable phantom</rdfs:label>
        <skos:altLabel>cylinder phantom</skos:altLabel>
        <skos:definition>A nuclear medicine phantom containing one or more empty compartments that can be filled with a radioactive solution.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000735 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000735">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
        <oboInOwl:id>NUCLEX:0000735</oboInOwl:id>
        <rdfs:label>Jaszczak phantom</rdfs:label>
        <skos:altLabel>Jaszczak</skos:altLabel>
        <skos:definition>A fillable cylindrical container used to ensure quality control for SPECT and PET imaging systems, testing spatial resolution, contrast, uniformity, and artifact reduction using inserts like cold rods and spheres.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000736 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000736">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000735"/>
        <oboInOwl:id>NUCLEX:0000736</oboInOwl:id>
        <rdfs:label>American College of Radiology-approved positron emission tomography phantom</rdfs:label>
        <skos:altLabel>ACR PET phantom</skos:altLabel>
        <skos:altLabel>ACR phantom</skos:altLabel>
        <skos:altLabel>ACR-approved PET phantom</skos:altLabel>
        <skos:altLabel>Data Spectrum deluxe phantom with PET faceplate</skos:altLabel>
        <skos:altLabel>Jaszczak deluxe ECT phantom with PET faceplate</skos:altLabel>
        <skos:altLabel>Jaszczak deluxe phantom with PET faceplate</skos:altLabel>
        <skos:altLabel>flangeless Esser PET phantom</skos:altLabel>
        <skos:definition>A fillable phantom composed of a flangeless Jaszczak phantom body with a rod resolution pattern paired with a specialized faceplate containing an arrangement of fillable (hot) and cold cylinders of varying diameters, to assess spatial resolution, object detectability, and uniformity.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000737 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000737">

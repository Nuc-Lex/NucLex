        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>UHIW</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000625 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000625">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000624"/>
        <oboInOwl:id>NUCLEX:0000625</oboInOwl:id>

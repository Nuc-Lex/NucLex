    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000722 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000722">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000688"/>
        <oboInOwl:id>NUCLEX:0000722</oboInOwl:id>
        <rdfs:label>phantom</rdfs:label>
        <skos:altLabel>imaging phantom</skos:altLabel>
        <skos:definition>An object that simulates a patient, tissue, or measurement condition in a scanner, often used to test the scanner&apos;s performance.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C17892</nx:ncit_id>
        <nx:snomedct_id>http://snomed.info/id/706342009</nx:snomedct_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000723 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000723">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000722"/>
        <oboInOwl:id>NUCLEX:0000723</oboInOwl:id>
        <rdfs:label>computational phantom</rdfs:label>
        <skos:altLabel>in silico phantom</skos:altLabel>
        <skos:altLabel>mathematical phantom</skos:altLabel>
        <skos:altLabel>virtual phantom</skos:altLabel>
        <skos:definition>A digital or mathematical model of a biological anatomy or physiology, utilized within computer simulations to evaluate radiation transport, dosimetry, and medical imaging system performance.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000724 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000724">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000723"/>
        <oboInOwl:id>NUCLEX:0000724</oboInOwl:id>
        <rdfs:label>radiation dose assessment resource phantom</rdfs:label>
        <skos:altLabel>RADAR phantom</skos:altLabel>
        <skos:definition>A computational phantom, encompassing both stylized and voxel-based models, developed by the Radiation Dose Assessment Resource task group to standardize internal and external radiopharmaceutical dosimetry calculations.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000725 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000725">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000723"/>
        <oboInOwl:id>NUCLEX:0000725</oboInOwl:id>
        <rdfs:label>adult reference computational phantom</rdfs:label>
        <skos:altLabel>ICRP adult reference computational phantom</skos:altLabel>
        <skos:altLabel>ICRP phantom</skos:altLabel>
        <skos:altLabel>ICRP reference phantom</skos:altLabel>
        <skos:definition>A standardized, high-resolution voxel-based computational phantom officially adopted by the International Commission on Radiological Protection (ICRP), representing the anatomical geometry of the adult Reference Male or Reference Female for uniform dosimetric evaluations.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000726 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000726">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000723"/>
        <oboInOwl:id>NUCLEX:0000726</oboInOwl:id>
        <rdfs:label>Oak Ridge National Laboratory computational phantom</rdfs:label>
        <skos:altLabel>ORNL computational phantom</skos:altLabel>
        <skos:altLabel>ORNL legacy phantom</skos:altLabel>
        <skos:altLabel>ORNL phantom</skos:altLabel>
        <skos:definition>A stylized computational phantom defined by three-dimensional mathematical equations, originally developed at ORNL to represent human anatomies across various ages and sexes for internal dosimetry.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000727 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000727">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000723"/>
        <oboInOwl:id>NUCLEX:0000727</oboInOwl:id>
        <rdfs:label>Rensselaer Polytechnic Institute visible photographic man phantom</rdfs:label>
        <skos:altLabel>RPI VIP-Man phantom</skos:altLabel>
        <skos:altLabel>RPI phantom</skos:altLabel>
        <skos:altLabel>VIP-Man phantom</skos:altLabel>
        <skos:definition>A high-resolution, voxel-based computational phantom (VIP-Man) constructed directly from the segmented, true-color anatomical photographs of the National Library of Medicine&apos;s Visible Human Project.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000728 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000728">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000723"/>
        <oboInOwl:id>NUCLEX:0000728</oboInOwl:id>
        <rdfs:label>Zubal phantom</rdfs:label>
        <skos:altLabel>Zubal</skos:altLabel>
        <skos:definition>A voxel-based computational phantom created from the detailed manual segmentation of transverse CT and MRI slices of a living human subject, primarily used to simulate realistic emission tomography data and internal radiation transport.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000729 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000729">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000723"/>
        <oboInOwl:id>NUCLEX:0000729</oboInOwl:id>
        <rdfs:label>XCAT phantom</rdfs:label>
        <skos:altLabel>XCAT</skos:altLabel>
        <skos:definition>A detailed, four-dimensional computational phantom utilizing Non-Uniform Rational B-Splines (NURBS) to mathematically model realistic human anatomy and physiological dynamics, particularly respiratory and cardiac motion, for advanced imaging simulation.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000730 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000730">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000729"/>
        <oboInOwl:id>NUCLEX:0000730</oboInOwl:id>
        <rdfs:label>XCAT brain phantom</rdfs:label>
        <skos:altLabel>XCAT brain</skos:altLabel>
        <skos:definition>A specialized regional configuration of the XCAT phantom utilizing advanced surface modeling to provide a highly detailed, segmented digital representation of human neuroanatomy for neurological imaging simulations.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000731 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000731">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000723"/>
        <oboInOwl:id>NUCLEX:0000731</oboInOwl:id>
        <rdfs:label>MOBY phantom</rdfs:label>
        <skos:altLabel>MOBY</skos:altLabel>
        <skos:definition>A four-dimensional computational phantom modeling the dynamic anatomy and physiological motion of a laboratory mouse, designed specifically for preclinical small-animal imaging and dosimetry research.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000732 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000732">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000723"/>
        <oboInOwl:id>NUCLEX:0000732</oboInOwl:id>
        <rdfs:label>ROBY phantom</rdfs:label>
        <skos:altLabel>ROBY</skos:altLabel>
        <skos:definition>A four-dimensional computational phantom modeling the dynamic anatomy and physiological motion of a laboratory rate, designed specifically for preclinical small-animal imaging and dosimetry research.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000733 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000733">

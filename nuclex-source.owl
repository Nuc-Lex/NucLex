        <skos:altLabel>entropy</skos:altLabel>
        <skos:altLabel>intensity-based entropy</skos:altLabel>
        <skos:definition>A statistical measure of the randomness or lack of uniformity in the distribution of gray-level intensities of voxel or pixel values.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>N8CA</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000631 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000631">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000628"/>
        <oboInOwl:id>NUCLEX:0000631</oboInOwl:id>
        <rdfs:label>intensity skewness</rdfs:label>
        <skos:altLabel>histogram skewness</skos:altLabel>
        <skos:altLabel>skewness</skos:altLabel>
        <skos:definition>A measure of the asymmetry of the histogram of voxels or pixel intensity values around its mean, indicating the distribution&apos;s tail direction.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>KE2A</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000632 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000632">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000628"/>
        <oboInOwl:id>NUCLEX:0000632</oboInOwl:id>
        <rdfs:label>intensity kurtosis</rdfs:label>
        <skos:altLabel>kurtosis</skos:altLabel>
        <skos:definition>A measure of the sharpness or &quot;peakedness&quot; of the histogram of voxel or pixel intensities compared to a normal distribution.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>IPH6</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000633 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000633">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000628"/>
        <oboInOwl:id>NUCLEX:0000633</oboInOwl:id>
        <rdfs:label>intensity-volume histogram feature</rdfs:label>
        <skos:altLabel>IVH feature</skos:altLabel>
        <skos:altLabel>IVH metric</skos:altLabel>
        <skos:definition>A quantity derived from the relationship between voxel value thresholds and the volume at or above each threshold.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>P88C</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000634 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000634">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000633"/>
        <oboInOwl:id>NUCLEX:0000634</oboInOwl:id>
        <rdfs:label>volume at intensity fraction</rdfs:label>
        <skos:altLabel>Vx</skos:altLabel>
        <skos:definition>The volume of a region of interest at or above a specified fraction of the highest voxel value.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>BC2M</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000635 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000635">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000635</oboInOwl:id>
        <rdfs:label>texture feature</rdfs:label>
        <skos:altLabel>higher order feature</skos:altLabel>
        <skos:definition>Stasticial features that encode special relationships between voxel intensities within a region of interest.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000636 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000636">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000635"/>
        <oboInOwl:id>NUCLEX:0000636</oboInOwl:id>
        <rdfs:label>gray-level co-occurrence based feature</rdfs:label>
        <skos:altLabel>GLCM feature</skos:altLabel>
        <skos:definition>Metrics derived from the matrix showing the frequency of pairs of pixels or voxels with specific intensity values occurring at a certain spatial relationship (distance/angle).</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>LFYI</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000637 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000637">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000636"/>
        <oboInOwl:id>NUCLEX:0000637</oboInOwl:id>
        <rdfs:label>inverse difference moment</rdfs:label>
        <skos:altLabel>homogeneity</skos:altLabel>
        <skos:definition>A measure of the closeness of the distribution of elements in the gray-level co-occurrence matrix to the diagonal, indicating local uniformity in pixels or voxels.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>WF0Z</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000638 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000638">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000636"/>
        <oboInOwl:id>NUCLEX:0000638</oboInOwl:id>
        <rdfs:label>contrast</rdfs:label>
        <skos:definition>A measure of the local variation in gray-level values, emphasizing differences between neighboring pixels or voxels.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>65HE</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000639 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000639">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000636"/>
        <oboInOwl:id>NUCLEX:0000639</oboInOwl:id>
        <rdfs:label>correlation</rdfs:label>
        <skos:definition>A measure of the linear dependence of gray levels of neighboring pixels or voxels.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>NI2N</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000640 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000640">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000635"/>
        <oboInOwl:id>NUCLEX:0000640</oboInOwl:id>
        <rdfs:label>gray-level run-length matrix feature</rdfs:label>
        <skos:altLabel>GLRLM feature</skos:altLabel>
        <skos:definition>Metrics derived from the matrix that quantifies the length and frequency of runs of pixels or voxels having the same gray-level intensity.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>TP0I</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000641 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000641">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000635"/>
        <oboInOwl:id>NUCLEX:0000641</oboInOwl:id>
        <rdfs:label>grey level distance zone based feature</rdfs:label>
        <skos:altLabel>GLDZM feature</skos:altLabel>
        <skos:definition>Any metric derived from a matrix that quantifies the distribution of gray levels based on the distance of a voxel from a specified point (e.g., the center) within a defined region of interest.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>VMDZ</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000642 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000642">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000635"/>
        <oboInOwl:id>NUCLEX:0000642</oboInOwl:id>
        <rdfs:label>neighbourhood grey tone difference based feature</rdfs:label>
        <skos:altLabel>NGTDM feature</skos:altLabel>
        <skos:definition>Any metric derived from a matrix that quantifies the spatial complexity by measuring the difference between the intensity of a voxel and the average intensity of its local neighborhood.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:ibsi_id>IPET</nx:ibsi_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000643 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000643">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000643</oboInOwl:id>
        <rdfs:label>morphological feature</rdfs:label>
        <skos:altLabel>morphological measurement</skos:altLabel>
        <skos:altLabel>shape measurement</skos:altLabel>
        <skos:definition>Any metric describing the three-dimensional geometry of a region, independent of its intensity values.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:obo_id>http://purl.obolibrary.org/obo/UBERON_0034768</nx:obo_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000644 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000644">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000643"/>
        <oboInOwl:id>NUCLEX:0000644</oboInOwl:id>
        <rdfs:label>concavity</rdfs:label>
        <skos:definition>A measure of the extent to which the boundary of a region of interest is indented relative to its convex hull.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:obo_id>http://purl.obolibrary.org/obo/PATO_0002005</nx:obo_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000645 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000645">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000643"/>
        <oboInOwl:id>NUCLEX:0000645</oboInOwl:id>
        <rdfs:label>sphericity</rdfs:label>
        <skos:definition>A measure comparing the bounding surface of a sphere of equal volume with the bounding surface of a region of interest.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000646 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000646">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000643"/>
        <oboInOwl:id>NUCLEX:0000646</oboInOwl:id>
        <rdfs:label>surface area to volume ratio</rdfs:label>
        <skos:altLabel>SA:V ratio</skos:altLabel>
        <skos:altLabel>surface to volume ratio</skos:altLabel>
        <skos:definition>A measure comparing the bounding surface of a region of interest with the space it encloses.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000647 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000647">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000643"/>
        <oboInOwl:id>NUCLEX:0000647</oboInOwl:id>
        <rdfs:label>compactness</rdfs:label>
        <skos:definition>A measure of the ratio between the volume of a region of interest and a power of its bounding surface.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000648 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000648">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000643"/>
        <oboInOwl:id>NUCLEX:0000648</oboInOwl:id>
        <rdfs:label>eccentricity</rdfs:label>
        <skos:definition>A measure of the deviation of a region of interest from a circular or spherical shape.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000649 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000649">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000643"/>
        <oboInOwl:id>NUCLEX:0000649</oboInOwl:id>
        <rdfs:label>flatness</rdfs:label>
        <skos:definition>A measure of the ratio between the smallest and the largest principal axis length of a region of interest.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000650 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000650">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000643"/>
        <oboInOwl:id>NUCLEX:0000650</oboInOwl:id>
        <rdfs:label>elongation</rdfs:label>
        <skos:definition>A measure of the ratio between the second-largest and the largest principal axis length of a region of interest.</skos:definition>
        <nx:approver_id>1001;1002;1005</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000651 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000651">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000651</oboInOwl:id>
        <rdfs:label>dynamic measurement</rdfs:label>
        <skos:altLabel>dynamic feature</skos:altLabel>
        <skos:altLabel>dynamic measurement</skos:altLabel>
        <skos:altLabel>multi-frame measurement</skos:altLabel>
        <skos:definition>A quantitative value that captures the change in imaging signal over time, derived from a series of images acquired at multiple time points</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000652 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000652">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000651"/>
        <oboInOwl:id>NUCLEX:0000652</oboInOwl:id>
        <rdfs:label>retention measurements</rdfs:label>
        <skos:definition>Any metric quantifying the total accumulation, duration, or total number of nuclear transformations within a defined source region.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000653 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000653">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000652"/>
        <oboInOwl:id>NUCLEX:0000653</oboInOwl:id>
        <rdfs:label>residence time</rdfs:label>
        <skos:altLabel>TIAC</skos:altLabel>
        <skos:altLabel>time integrated activity coefficient</skos:altLabel>
        <skos:definition>The total accumulated time that a unit of administered activity spends in a specified source region, calculated as the ratio of Time-Integrated Activity to the administered activity.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000654 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000654">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000652"/>
        <oboInOwl:id>NUCLEX:0000654</oboInOwl:id>
        <rdfs:label>effective half life</rdfs:label>
        <skos:altLabel>T1/2</skos:altLabel>
        <skos:definition>The time required for the amount of radioactivity in an organ or tissue to be reduced by half, accounting for both physical decay and biological elimination.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000655 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000655">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000652"/>
        <oboInOwl:id>NUCLEX:0000655</oboInOwl:id>
        <rdfs:label>area under the time activity curve</rdfs:label>
        <skos:altLabel>AUC</skos:altLabel>
        <skos:definition>The area beneath the curve of a time-activity plot, numerically equivalent to the Time-Integrated Activity over the defined time interval.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000656 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000656">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000652"/>
        <oboInOwl:id>NUCLEX:0000656</oboInOwl:id>
        <rdfs:label>time-integrated activity</rdfs:label>
        <skos:altLabel>TIA</skos:altLabel>
        <skos:definition>The total number of nuclear transformations occurring in a source region over a specified time interval, serving as the critical measure for absorbed dose calculation.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000657 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000657">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000651"/>
        <oboInOwl:id>NUCLEX:0000657</oboInOwl:id>
        <rdfs:label>mean transit time</rdfs:label>
        <skos:definition>The average time that a single tracer molecule or particle spends within a defined compartment or vascular system.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000658 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000658">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000651"/>
        <oboInOwl:id>NUCLEX:0000658</oboInOwl:id>
        <rdfs:label>time-to-peak</rdfs:label>
        <skos:altLabel>Tpeak</skos:altLabel>
        <skos:definition>The time from baseline to the maximum signal in the region of interest.</skos:definition>
        <nx:status>draft</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000659 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000659">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000651"/>
        <oboInOwl:id>NUCLEX:0000659</oboInOwl:id>
        <rdfs:label>time-activity measurement</rdfs:label>
        <skos:altLabel>TAC</skos:altLabel>
        <skos:definition>A plot or graphical representation showing the measured amount of radioactivity (activity concentration or counts) within a specific spatial region over sequential time points.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000660 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000660">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000659"/>
        <oboInOwl:id>NUCLEX:0000660</oboInOwl:id>
        <rdfs:label>arterial input function</rdfs:label>
        <skos:altLabel>AIF</skos:altLabel>
        <skos:definition>The time-activity curve measured from an arterial structure (e.g., the aorta or left ventricle) that is used to represent the concentration of tracer entering a target tissue.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000661 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000661">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000659"/>
        <oboInOwl:id>NUCLEX:0000661</oboInOwl:id>
        <rdfs:label>venous input function</rdfs:label>
        <skos:altLabel>VIF</skos:altLabel>
        <skos:definition>The time-activity curve measured from a venous structure, often used to represent the concentration of tracer leaving a target tissue or organ.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000662 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000662">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000659"/>
        <oboInOwl:id>NUCLEX:0000662</oboInOwl:id>
        <rdfs:label>tissue time-activity curve</rdfs:label>
        <skos:altLabel>tissue TAC</skos:altLabel>
        <skos:definition>The time-activity curve measured specifically from a defined non-vascular, biological tissue or organ.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:assigned_to>1005</nx:assigned_to>
        <nx:status>needs approval</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000663 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000663">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000659"/>
        <oboInOwl:id>NUCLEX:0000663</oboInOwl:id>
        <rdfs:label>voxel time-activity curve</rdfs:label>
        <skos:altLabel>voxel TAC</skos:altLabel>

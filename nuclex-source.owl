        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000750 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000750">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000749"/>
        <oboInOwl:id>NUCLEX:0000750</oboInOwl:id>
        <rdfs:label>flanged cylindrical fillable flood phantom</rdfs:label>
        <skos:altLabel>WCC phantom</skos:altLabel>
        <skos:altLabel>quantitative calibration phantom</skos:altLabel>

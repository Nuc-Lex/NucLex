        <skos:definition>A standardized fillable phantom developed by the SNMMI Clinical Trials Network to simulate a human torso with oncology-relevant lesions, used to harmonize quantitative imaging across multi-center trials.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000746 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000746">

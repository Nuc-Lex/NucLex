    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0001165">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000437"/>
        <oboInOwl:id>NUCLEX:0001165</oboInOwl:id>
        <rdfs:label>Fluorine F-18 Flutriciclamide</rdfs:label>

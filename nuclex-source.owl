        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000594 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000594">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000593"/>
        <oboInOwl:id>NUCLEX:0000594</oboInOwl:id>

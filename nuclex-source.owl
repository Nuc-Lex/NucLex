        <oboInOwl:id>NUCLEX:0000540</oboInOwl:id>
        <rdfs:label>image observable</rdfs:label>
        <skos:altLabel>image measurement</skos:altLabel>
        <skos:altLabel>image observation</skos:altLabel>
        <skos:altLabel>imaging observation</skos:altLabel>
        <skos:definition>A quality or quantity whose value is determined from a medical image.</skos:definition>
        <nx:approver_id>1001;1002</nx:approver_id>
        <nx:radlex_id>http://www.radlex.org/RID/RID5</nx:radlex_id>
        <nx:snomedct_id rdf:resource="http://snomed.info/id/399060005"/>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000541 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000541">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000039"/>
        <oboInOwl:id>NUCLEX:0000541</oboInOwl:id>
        <rdfs:label>imaging assessment criteria</rdfs:label>
        <skos:altLabel>assessment</skos:altLabel>
        <skos:altLabel>image evaluation criteria</skos:altLabel>
        <skos:altLabel>imaging evaluation guidelines</skos:altLabel>
        <skos:altLabel>imaging reporting criteria</skos:altLabel>
        <skos:definition>A standardized set of rules applied to the interpretation of medical imaging data to ensure uniform evaluation or reporting.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000542 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000542">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000043"/>
        <oboInOwl:id>NUCLEX:0000542</oboInOwl:id>
        <rdfs:label>oncology therapy response evaluation criteria</rdfs:label>
        <skos:altLabel>cancer response evaluation criteria</skos:altLabel>
        <skos:altLabel>therapy response criteria</skos:altLabel>
        <skos:altLabel>tumor response criteria</skos:altLabel>
        <skos:definition>A standardized set of quantitative and qualitative imaging rules designed to measure and classify temporal changes in neoplastic disease burden following therapeutic intervention.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000543 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000543">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000543</oboInOwl:id>
        <rdfs:label>Deauville five-point scale</rdfs:label>
        <skos:altLabel>5-point scale</skos:altLabel>
        <skos:altLabel>Deauville 5-point scale</skos:altLabel>
        <skos:altLabel>Deauville scale</skos:altLabel>
        <skos:altLabel>Deauville score</skos:altLabel>
        <skos:altLabel>Deauville scoring</skos:altLabel>
        <skos:altLabel>five-point scale</skos:altLabel>
        <skos:definition>A 5-point visual scoring system used to interpret FDG-PET/CT scans in lymphoma. It standardizes response assessment by comparing the metabolic activity (FDG PET uptake) in a tumor to the activity in reference points, specifically the mediastinal blood pool and the liver.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000544 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000544">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000032"/>
        <oboInOwl:id>NUCLEX:0000544</oboInOwl:id>
        <rdfs:label>mIBG score</rdfs:label>
        <skos:altLabel>metaiodobenzylguanidine score</skos:altLabel>
        <skos:definition>A semi-quantitative measure of the extent of abnormal metaiodobenzylguanidine uptake.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000545 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000545">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000544"/>
        <oboInOwl:id>NUCLEX:0000545</oboInOwl:id>
        <rdfs:comment>Both diagnostic and response assessment</rdfs:comment>
        <rdfs:label>Curie score</rdfs:label>
        <skos:definition>A semi-quantitative measure of metaiodobenzylguanidine uptake obtained by grading abnormal skeletal uptake across ten anatomical segments.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000546 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000546">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000544"/>
        <oboInOwl:id>NUCLEX:0000546</oboInOwl:id>
        <rdfs:label>modified Curie score</rdfs:label>
        <skos:definition>A revision of the Curie score using altered segment definitions and grading criteria.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000547 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000547">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000544"/>
        <oboInOwl:id>NUCLEX:0000547</oboInOwl:id>
        <rdfs:label>SIOPEN score</rdfs:label>
        <skos:altLabel>SIOPEN mIBG score</skos:altLabel>
        <skos:definition>A semi-quantitative measure of metaiodobenzylguanidine uptake obtained by grading abnormal skeletal uptake across twelve anatomical segments.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000548 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000548">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000548</oboInOwl:id>
        <rdfs:label>response evaluation criteria in prostate-specific membrane antigen positron emission tomography/computed tomography</rdfs:label>
        <skos:altLabel>RECIP</skos:altLabel>
        <skos:altLabel>response evaluation criteria in PSMA PET/CT</skos:altLabel>
        <skos:altLabel>response evaluation in PSMA PET</skos:altLabel>
        <skos:definition>Criteria for standardized assessment of tumor response to therapy in prostate cancer using PSMA PET/CT scans. It defines rules for confirming a response or progression based on changes in PSMA-avid tumor burden.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000549 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000549">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000549</oboInOwl:id>
        <rdfs:label>response evaluation criteria in solid tumors</rdfs:label>
        <skos:altLabel>RECIST</skos:altLabel>
        <skos:definition>A set of criteria that classifies response to therapy based on the change in the size (sum of longest diameters) of target lesions on CT or MRI.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C49164</nx:ncit_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000550 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000550">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000550</oboInOwl:id>
        <rdfs:label>positron emission tomography response criteria in solid tumors</rdfs:label>
        <rdfs:seeAlso>10.2967/jnumed.108.057307</rdfs:seeAlso>
        <skos:altLabel>PERCIST</skos:altLabel>
        <skos:definition>Criteria for assessing tumor response to therapy using functional changes on PET scans. It focuses on changes in the metabolic activity (specifically, the peak SUV) of tumors, rather than just changes in size.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000551 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000551">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000551</oboInOwl:id>
        <rdfs:label>European Organisation for Research and Treatment of Cancer positron emission tomography criteria</rdfs:label>
        <skos:altLabel>EORTC PET criteria</skos:altLabel>
        <skos:altLabel>EORTC criteria</skos:altLabel>
        <skos:definition>A standardized metabolic imaging framework that evaluates neoplastic disease response to therapy based on relative temporal changes in maximum standardized uptake value.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000552 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000552">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000552</oboInOwl:id>
        <rdfs:label>positron emission tomography/computed tomography criteria for early prediction of response to immune checkpoint inhibitor therapy</rdfs:label>
        <skos:altLabel>PECRIT</skos:altLabel>
        <skos:altLabel>PECRIT criteria</skos:altLabel>
        <skos:altLabel>PET/CT criteria for early prediction of response to immune checkpoint inhibitor therapy</skos:altLabel>
        <skos:definition>A dual-modality imaging framework combining anatomical size measurements and metabolic uptake parameters to quantitatively assess early therapeutic efficacy of immune checkpoint inhibitors.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000553 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000553">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000553</oboInOwl:id>
        <rdfs:label>positron emission tomography response evaluation criteria for immunotherapy</rdfs:label>
        <skos:altLabel>PERCIMT</skos:altLabel>
        <skos:altLabel>PET response evaluation criteria for immunotherapy</skos:altLabel>
        <skos:definition>A metabolic imaging assessment framework for immunomodulatory therapies that classifies disease response based primarily on the quantitative assessment of newly emergent hypermetabolic lesions.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000554 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000554">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000554</oboInOwl:id>
        <rdfs:label>immune-related response evaluation criteria in solid tumors</rdfs:label>
        <skos:altLabel>iRECIST</skos:altLabel>
        <skos:altLabel>immune-related response evaluation criteria in solid tumors</skos:altLabel>
        <skos:altLabel>response evaluation criteria in solid tumors for immune-based therapeutics</skos:altLabel>
        <skos:definition>An anatomical imaging evaluation framework modified for immunomodulatory therapies that standardizes the measurement of tumor burden while accommodating atypical treatment kinetics such as pseudoprogression.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C140313</nx:ncit_id>
        <nx:snomedct_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C140313</nx:snomedct_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000555 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000555">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000542"/>
        <oboInOwl:id>NUCLEX:0000555</oboInOwl:id>
        <rdfs:label>immune-related positron emission tomography response criteria in solid tumors</rdfs:label>
        <skos:altLabel>iPERCIST</skos:altLabel>
        <skos:definition>A metabolic imaging evaluation framework adapted for immunomodulatory therapies that incorporates the phenomenon of pseudoprogression into the assessment of tumor response using radiotracer uptake parameters.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000556 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000556">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000043"/>
        <oboInOwl:id>NUCLEX:0000556</oboInOwl:id>
        <rdfs:label>oncology diagnostic imaging interpretation and reporting criteria</rdfs:label>
        <skos:altLabel>cancer diagnostic imaging guidelines</skos:altLabel>
        <skos:altLabel>diagnostic interpretation criteria</skos:altLabel>
        <skos:altLabel>diagnostic reporting criteria</skos:altLabel>
        <skos:definition>A structured protocol governing the radiologic interpretation and formal documentation of imaging findings associated with neoplastic disease characterization.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000557 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000557">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000556"/>
        <oboInOwl:id>NUCLEX:0000557</oboInOwl:id>
        <rdfs:label>Lugano five-point scale</rdfs:label>
        <skos:altLabel>Lugano 5-point scale</skos:altLabel>
        <skos:altLabel>Lugano criteria</skos:altLabel>
        <skos:definition>A standard for staging, response assessment, and surveillance of lymphoma. It provides an integrated framework that combines clinical findings with imaging results.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000558 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000558">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000556"/>
        <oboInOwl:id>NUCLEX:0000558</oboInOwl:id>
        <rdfs:label>prostate-specific membrane antigen reporting and data system</rdfs:label>
        <skos:altLabel>PSMA-RADS</skos:altLabel>
        <skos:definition>A system for standardizing the interpretation and reporting of PSMA PET scans.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000559 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000559">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000556"/>
        <oboInOwl:id>NUCLEX:0000559</oboInOwl:id>
        <rdfs:label>prostate cancer molecular imaging standardized evaluation</rdfs:label>
        <skos:altLabel>PROMISE</skos:altLabel>
        <skos:altLabel>PROMISE criteria</skos:altLabel>
        <skos:definition>A guide for the interpretation of PSMA-PET scans. PROMISE classifies the extent of disease on a PSMA-PET scan by categorizing it into specific regions: local (T), lymph node (N), and organ (M) spread. Disease extent and location is reported for all body regions and summarized in a comprehensive diagnosis code.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000560 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000560">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000556"/>
        <oboInOwl:id>NUCLEX:0000560</oboInOwl:id>
        <rdfs:label>E-PSMA</rdfs:label>
        <skos:altLabel>EANM standardized reporting guidelines for PSMA-PET</skos:altLabel>
        <skos:definition>A set of standardized reporting guidelines for PSMA PET developed and endorsed by the European Association of Nuclear Medicine</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000561 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000561">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000032"/>
        <oboInOwl:id>NUCLEX:0000561</oboInOwl:id>
        <rdfs:label>Krenning score</rdfs:label>
        <skos:altLabel>Krenning grade</skos:altLabel>
        <skos:altLabel>Krenning number</skos:altLabel>
        <skos:definition>A numerical score used to grade the uptake intensity of neuroendocrine tumors on somatostatin receptor imaging such as octreotide scan.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000562 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000562">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000556"/>
        <oboInOwl:id>NUCLEX:0000562</oboInOwl:id>
        <rdfs:label>fibroblast activation protein reporting and data system</rdfs:label>
        <skos:altLabel>FAP-RADS</skos:altLabel>
        <skos:altLabel>fibroblast activation protein RADS</skos:altLabel>
        <skos:definition>A structured interpretation and reporting framework designed to standardize the evaluation and categorization of fibroblast activation protein-targeted radiotracer uptake in molecular imaging.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000563 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000563">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000556"/>
        <oboInOwl:id>NUCLEX:0000563</oboInOwl:id>
        <rdfs:label>somatostatin receptor reporting and data system</rdfs:label>
        <skos:altLabel>SSTR 5-point scale</skos:altLabel>
        <skos:altLabel>SSTR-RADS</skos:altLabel>
        <skos:definition>A structured imaging classification system formulated to standardize the interpretation, reporting, and clinical categorization of somatostatin receptor-targeted molecular imaging.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000564 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000564">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000032"/>
        <oboInOwl:id>NUCLEX:0000564</oboInOwl:id>
        <rdfs:label>bone scan index</rdfs:label>
        <skos:altLabel>BSI</skos:altLabel>
        <skos:altLabel>automated bone scan index</skos:altLabel>
        <skos:definition>The proportion of total skeletal mass occupied by metastatic lesions identified on a bone scan.</skos:definition>
        <nx:approver_id>1001;1002;1004</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000565 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000565">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000540"/>
        <oboInOwl:id>NUCLEX:0000565</oboInOwl:id>
        <rdfs:label>region of interest measurement</rdfs:label>
        <skos:altLabel>ROI measurement</skos:altLabel>
        <skos:altLabel>radiomics feature</skos:altLabel>
        <skos:altLabel>voxel measurement</skos:altLabel>
        <skos:definition>A quantitative value derived from a defined spatial boundary on a medical image, representing either the statistical properties of the enclosed pixel or voxel intensities or the geometric attributes of the region itself.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000566 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000566">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000566</oboInOwl:id>
        <rdfs:label>length-based measurement</rdfs:label>
        <skos:altLabel>length measurement</skos:altLabel>
        <skos:definition>A measurement that quantifies a one-dimensional spatial property of an region of interest, such as its span or thickness.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000567 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000567">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000566"/>
        <oboInOwl:id>NUCLEX:0000567</oboInOwl:id>
        <rdfs:label>region of interest length</rdfs:label>
        <skos:altLabel>ROI length</skos:altLabel>
        <skos:definition>A length-based measurement of the distance across a region of interest.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000568 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000568">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000567"/>
        <oboInOwl:id>NUCLEX:0000568</oboInOwl:id>
        <rdfs:label>short-axis length</rdfs:label>
        <skos:altLabel>minor-axis diameter</skos:altLabel>
        <skos:altLabel>short-axis diameter</skos:altLabel>
        <skos:definition>The measurement of the longest distance across a region of interest along the shortest axis that is perpendicular to the object&apos;s long axis.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000569 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000569">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000567"/>
        <oboInOwl:id>NUCLEX:0000569</oboInOwl:id>
        <rdfs:label>long-axis length</rdfs:label>
        <skos:altLabel>long-axis diameter</skos:altLabel>
        <skos:altLabel>major-axis diameter</skos:altLabel>
        <skos:definition>The measurement of the longest distance across a region of interest.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000570 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000570">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000567"/>
        <oboInOwl:id>NUCLEX:0000570</oboInOwl:id>
        <rdfs:label>median-axis length</rdfs:label>
        <skos:altLabel>median-axis diameter</skos:altLabel>
        <skos:definition>The measurement of the distance across a 3D region of interest along the axis whose length lies between the short and long axes.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000571 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000571">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000567"/>
        <oboInOwl:id>NUCLEX:0000571</oboInOwl:id>
        <rdfs:label>in-plane length</rdfs:label>
        <skos:altLabel>in-plane diameter</skos:altLabel>
        <skos:definition>A length measurement taken exclusively within a single 2D image plane (e.g., a single axial, coronal, or sagittal slice)</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000572 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000572">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000567"/>
        <oboInOwl:id>NUCLEX:0000572</oboInOwl:id>
        <rdfs:label>maximum length</rdfs:label>
        <skos:altLabel>longest diameter</skos:altLabel>
        <skos:altLabel>maximum diameter</skos:altLabel>
        <skos:definition>The single greatest dimension of a object, measured in any plane or orientation.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:ncit_id>http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C96684</nx:ncit_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000573 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000573">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000567"/>
        <oboInOwl:id>NUCLEX:0000573</oboInOwl:id>
        <rdfs:label>lumen diameter</rdfs:label>
        <skos:altLabel>hollow diameter</skos:altLabel>
        <skos:definition>The long-axis inner length of a tubular structure, such as a blood vessel, measured on a plane perpendicular to the long-axis of the structure.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000574 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000574">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000566"/>
        <oboInOwl:id>NUCLEX:0000574</oboInOwl:id>
        <rdfs:label>imaging distance</rdfs:label>
        <skos:altLabel>inter-object distance</skos:altLabel>
        <skos:definition>The Euclidean distance between two objects in an image.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000575 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000575">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000574"/>
        <oboInOwl:id>NUCLEX:0000575</oboInOwl:id>
        <rdfs:label>maximum tumor dissemination</rdfs:label>
        <skos:altLabel>Dmax</skos:altLabel>
        <skos:altLabel>maximum dissemination</skos:altLabel>
        <skos:definition>The greatest three-dimensional Euclidean distance between the centroids of two malignant lesions in an image, typically used in lymphoma PET imaging.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000576 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000576">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000574"/>
        <oboInOwl:id>NUCLEX:0000576</oboInOwl:id>
        <rdfs:label>maximum spleen to tumor distance</rdfs:label>
        <skos:altLabel>Dspleen</skos:altLabel>
        <skos:definition>The greatest three-dimensional Euclidean distance between the centroid of the spleen and the centroid of a malignant lesions in an image, typically used in lymphoma PET imaging.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000577 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000577">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000565"/>
        <oboInOwl:id>NUCLEX:0000577</oboInOwl:id>
        <rdfs:label>volume measurement</rdfs:label>
        <skos:altLabel>volume measure</skos:altLabel>

        <oboInOwl:id>NUCLEX:0000605</oboInOwl:id>
        <rdfs:label>peak standardized uptake value</rdfs:label>
        <skos:altLabel>SUVpeak</skos:altLabel>
        <skos:altLabel>peak SUV</skos:altLabel>
        <skos:definition>The mean standardized uptake value within a small, predefined volume (e.g., 1 cm^3) centered around the voxel with the highest standardized uptake value.</skos:definition>
        <nx:approver_id>1001;1002;1003</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000606 -->


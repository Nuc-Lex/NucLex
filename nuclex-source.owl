        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000751 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000751">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
        <oboInOwl:id>NUCLEX:0000751</oboInOwl:id>
        <rdfs:label>National Electrical Manufacturers Association positron emission tomography sensitivity phantom</rdfs:label>
        <skos:altLabel>NEMA PET sensitivity phantom</skos:altLabel>
        <skos:altLabel>NEMA line source sensitivity phantom</skos:altLabel>
        <skos:altLabel>NEMA sensitivity phantom</skos:altLabel>
        <skos:definition>A standardized phantom comprising concentric aluminum tubes of varying diameters, designed by NEMA to measure the sensitivity of a PET scanner to positron-emitting sources.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000752 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000752">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
        <oboInOwl:id>NUCLEX:0000752</oboInOwl:id>
        <rdfs:label>National Electrical Manufacturers Association positron emission tomography scatter phantom</rdfs:label>
        <skos:altLabel>NECR phantom</skos:altLabel>
        <skos:altLabel>NEMA NECR phantom</skos:altLabel>
        <skos:altLabel>NEMA count rate phantom</skos:altLabel>
        <skos:altLabel>NEMA decay phantom</skos:altLabel>
        <skos:definition>A large, standardized, solid cylindrical phantom made of polyethylene, containing a line source hole offset from the center, used by NEMA protocols to measure the scatter fraction and count rate performance of PET systems.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000753 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000753">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
        <oboInOwl:id>NUCLEX:0000753</oboInOwl:id>
        <rdfs:label>National Electrical Manufacturers Association single-photon emission computed tomography triple line source phantom</rdfs:label>
        <skos:altLabel>NEMA SPECT phantom</skos:altLabel>
        <skos:definition>A cylindrical phantom containing three parallel fillable line sources, specified by NEMA for evaluating the spatial resolution of SPECT systems with or without scatter.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000754 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000754">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
        <oboInOwl:id>NUCLEX:0000754</oboInOwl:id>
        <rdfs:label>Radiology Suppport Devices Heart and Thorax phantom</rdfs:label>
        <skos:altLabel>RSD heart &amp; thorax phantom</skos:altLabel>
        <skos:altLabel>RSD heart and thorax phantom</skos:altLabel>
        <skos:altLabel>heart and thorax phantom</skos:altLabel>
        <skos:definition>An anthropomorphic phantom designed by Radiology Support Devices to simulate the human thorax, containing lung, liver, and cardiac inserts.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000755 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000755">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000733"/>
        <oboInOwl:id>NUCLEX:0000755</oboInOwl:id>
        <rdfs:label>Graves phantom</rdfs:label>
        <skos:altLabel>Graves calibration phantom</skos:altLabel>
        <skos:definition>A water-equivalent, cylindrical nuclear medicine phantom designed to hold standard lab bottles of radionuclides, used to provide realistic scatter conditions for calculating quantitative SPECT system sensitivity factors.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000756 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000756">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000733"/>
        <oboInOwl:id>NUCLEX:0000756</oboInOwl:id>
        <rdfs:label>neck phantom</rdfs:label>
        <skos:altLabel>neck thyroid phantom</skos:altLabel>
        <skos:altLabel>thyroid neck phantom</skos:altLabel>
        <skos:altLabel>thyroid quantification phantom</skos:altLabel>
        <skos:altLabel>thyroid uptake neck phantom</skos:altLabel>
        <skos:definition>A solid plastic cylindrical nuclear medicine phantom designed to simulate the scattering and attenuation properties of the human neck, featuring a standardized cavity designed to accommodate a radioactive pill, vial, or bottle used in the quantification of thyroid uptake for a patient.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000757 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000757">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000733"/>
        <oboInOwl:id>NUCLEX:0000757</oboInOwl:id>
        <rdfs:label>sealed source nuclear medicine phantom</rdfs:label>
        <skos:altLabel>sealed source NM phantom</skos:altLabel>
        <skos:altLabel>sealed source phantom</skos:altLabel>
        <skos:definition>A nuclear medicine phantom containing radioactive material that is permanently encapsulated or enclosed in a solid matrix, preventing the user from direct contact with the radioactive substance.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000758 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000758">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000757"/>
        <oboInOwl:id>NUCLEX:0000758</oboInOwl:id>
        <rdfs:label>[68Ge] cylindrical phantom</rdfs:label>
        <skos:altLabel>DQA phantom</skos:altLabel>
        <skos:altLabel>Ge-68 PET cylindrical phantom</skos:altLabel>
        <skos:altLabel>Ge-68 cylindrical phantom</skos:altLabel>
        <skos:altLabel>daily quality assurance phantom</skos:altLabel>
        <skos:definition>A sealed cylindrical phantom containing a uniform, solid distribution of Germanium-68, commonly used for routine PET quality control.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000759 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000759">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000757"/>
        <oboInOwl:id>NUCLEX:0000759</oboInOwl:id>
        <rdfs:label>[68Ge] annulus phantom</rdfs:label>
        <skos:altLabel>DQA phantom</skos:altLabel>
        <skos:altLabel>PET DQA phantom</skos:altLabel>
        <skos:altLabel>daily quality assurance phantom</skos:altLabel>
        <skos:definition>A sealed, ring-shaped phantom containing Germanium-68, commonly used for PET calibrations.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000760 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000760">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000757"/>
        <oboInOwl:id>NUCLEX:0000760</oboInOwl:id>
        <rdfs:label>[68Ge] rod phantom</rdfs:label>
        <skos:altLabel>line source</skos:altLabel>
        <skos:altLabel>rod source</skos:altLabel>
        <skos:definition>A sealed, rod-shaped source containing Germanium-68, often used for PET calibrations or transmission scanning.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000761 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000761">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000757"/>
        <oboInOwl:id>NUCLEX:0000761</oboInOwl:id>
        <rdfs:label>[22Na] line source</rdfs:label>
        <skos:altLabel>line source</skos:altLabel>
        <skos:definition>A sealed linear source containing Sodium-22, used in PET testing or calibrations.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000762 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000762">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000757"/>
        <oboInOwl:id>NUCLEX:0000762</oboInOwl:id>
        <rdfs:label>[57Co] sheet source</rdfs:label>
        <skos:altLabel>sheet source</skos:altLabel>
        <skos:definition>A sealed, flat, rectangular or circular source containing a uniform distribution of Cobalt-57, used primarily for daily field uniformity testing of gamma cameras.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000763 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000763">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000733"/>
        <oboInOwl:id>NUCLEX:0000763</oboInOwl:id>
        <rdfs:label>nuclear medicine bar phantom</rdfs:label>
        <skos:altLabel>NM bar phantom</skos:altLabel>
        <skos:definition>A planar test object consisting of radio-opaque bars embedded in a radiolucent material, used in conjunction with a uniform radioactive source to evaluate the spatial resolution and linearity of a gamma camera.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000764 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000764">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000763"/>
        <oboInOwl:id>NUCLEX:0000764</oboInOwl:id>
        <rdfs:label>four-quadrant bar phantom</rdfs:label>
        <skos:altLabel>quadrant bar phantom</skos:altLabel>
        <skos:definition>A nuclear medicine bar phantom divided into four sections, each containing parallel radio-opaque bars of a different width and spacing, used for visual assessment of gamma camera resolution.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000765 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000765">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000763"/>
        <oboInOwl:id>NUCLEX:0000765</oboInOwl:id>
        <rdfs:label>parallel line equal spacing phantom</rdfs:label>
        <skos:altLabel>PLES phantom</skos:altLabel>
        <skos:altLabel>slit phantom</skos:altLabel>
        <skos:definition>A nuclear medicine bar phantom consisting of parallel radio-opaque bars of uniform width and spacing across the entire field of view, used to measure gamma camera spatial linearity and resolution.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000766 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000766">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000733"/>
        <oboInOwl:id>NUCLEX:0000766</oboInOwl:id>
        <rdfs:label>nuclear medicine/computed tomography coregistration phantom</rdfs:label>
        <skos:altLabel>alignment phantom</skos:altLabel>
        <skos:altLabel>coregistration phantom</skos:altLabel>
        <skos:definition>A phantom containing structures or fiducial markers that are visible on both nuclear medicine (PET/SPECT) and CT modalities, used to evaluate and calibrate the spatial alignment between the two imaging systems.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000767 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000767">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000766"/>
        <oboInOwl:id>NUCLEX:0000767</oboInOwl:id>
        <rdfs:label>volumetric quality control phantom</rdfs:label>
        <skos:altLabel>VQC phantom</skos:altLabel>
        <skos:definition>A specific nuclear medicine/computed tomography coregistration phantom made out of foam with radioactive inserts that are visible in both nuclear medicine and CT images.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000768 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000768">

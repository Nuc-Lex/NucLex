        <skos:altLabel>NEMA IEC PET body phantom</skos:altLabel>
        <skos:altLabel>NEMA PET image quality phantom</skos:altLabel>
        <skos:altLabel>NEMA PET phantom</skos:altLabel>
        <skos:definition>A standardized fillable body-shaped phantom specified by NEMA and the IEC, typically containing a simulated background compartment, a lung insert, and several fillable spheres, used to evaluate PET image quality.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000741 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000741">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000739"/>
        <oboInOwl:id>NUCLEX:0000741</oboInOwl:id>
        <rdfs:label>National Electrical Manufacturers Association International Electrotechnical Commission single-photon emission computed tomography body phantom</rdfs:label>
        <skos:altLabel>NEMA IEC NM body phantom</skos:altLabel>
        <skos:altLabel>NEMA IEC SPECT body phantom</skos:altLabel>
        <skos:altLabel>NEMA NM image quality phantom</skos:altLabel>
        <skos:altLabel>NEMA SPECT image quality phantom</skos:altLabel>
        <skos:altLabel>NEMA SPECT phantom</skos:altLabel>
        <skos:definition>A standardized fillable body-shaped phantom specified by NEMA and the IEC, typically containing a simulated background compartment, a lung insert, and several fillable spheres, used to evaluate SPECT image quality.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000742 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000742">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
        <oboInOwl:id>NUCLEX:0000742</oboInOwl:id>
        <rdfs:label>Hoffman brain phantom</rdfs:label>
        <skos:altLabel>Hoffman phantom</skos:altLabel>
        <skos:definition>A fillable nuclear medicine phantom containing complex internal structures that simulate the distinct regional distribution of gray and white matter in the human brain.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000743 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000743">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
        <oboInOwl:id>NUCLEX:0000743</oboInOwl:id>
        <rdfs:label>Derenzo phantom</rdfs:label>
        <skos:definition>A fillable nuclear medicine phantom containing multiple sets of parallel rods or holes of varying diameters arranged in pie-shaped sectors, used to evaluate the in-plane spatial resolution of tomographic systems.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000744 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000744">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000743"/>
        <oboInOwl:id>NUCLEX:0000744</oboInOwl:id>
        <rdfs:label>micro Derenzo phantom</rdfs:label>
        <skos:definition>A miniaturized version of the Derenzo phantom designed for evaluating the high spatial resolution of pre-clinical or small-animal PET and SPECT systems.</skos:definition>
        <nx:approver_id>1001;1002;1010</nx:approver_id>
        <nx:status>approved</nx:status>
    </owl:Class>
    


    <!-- https://nuclex.com/id/NUCLEX_0000745 -->

    <owl:Class rdf:about="https://nuclex.com/id/NUCLEX_0000745">
        <rdfs:subClassOf rdf:resource="https://nuclex.com/id/NUCLEX_0000734"/>
